# Copy to docker/.env and edit. Every setting the app reads is listed here, with
# what happens if you get it wrong.
#
#   cp docker/.env.example docker/.env
#
# docker/.env is git-ignored. It holds no secrets today, and it is the file
# people put secrets in, so it stays out of the repository either way.


# --- what the host publishes --------------------------------------------------

# The interface the API is reachable on. 127.0.0.1 means this machine only,
# which is the right answer until your IT department has told you the network rules for
# de-identified research data. 0.0.0.0 publishes it to whatever the machine is
# attached to. There is no middle setting that makes that safe by itself.
BIND=127.0.0.1
PORT=8000

# nginx, only with --profile nginx.
HTTPS_PORT=8443
TLS_DIR=./tls


# --- data ---------------------------------------------------------------------

# The recordings, mounted read-only. A path on the host, absolute or relative to
# docker/. On this machine data/ is a symlink into cloud-synced storage, and a
# symlink does not survive a bind mount: point this at the directory the symlink
# resolves to, not at the symlink.
DATA_DIR=../data


# --- how runs execute ----------------------------------------------------------

# queue: the worker container executes runs. This is the only correct value for
# a deployment. background runs them inside the API process, where a restart
# loses the run and no other process can see its status.
DBSSPEECH_EXECUTOR=queue


# --- authentication ------------------------------------------------------------

# Must be true here. The API binds 0.0.0.0 inside the container, and `serve`
# refuses to do that unauthenticated: the failure worth preventing is not a weak
# password, it is an unauthenticated app answering on a hospital network.
#
# Create the first account after the first start:
#   docker compose -f docker/compose.yml exec api python -m dbsspeech users add
DBSSPEECH_REQUIRE_AUTH=true


# --- limits --------------------------------------------------------------------

# Largest upload the API accepts, in bytes. Default 8 GiB. A tank block from one
# case is comfortably over a gigabyte, so this is deliberately generous.
DBSSPEECH_MAX_UPLOAD_BYTES=8589934592


# --- paths inside the container -------------------------------------------------
#
# These match the volumes in compose.yml. Change them only if you also change
# the volumes, and remember the container user is uid 10001: the host
# directories behind those volumes have to be writable by it.
DBSSPEECH_DATA=/app/data
DBSSPEECH_DERIVATIVES=/app/derivatives
DBSSPEECH_RUNS=/app/runs
DBSSPEECH_WEB_DIST=/app/web/dist

# Uploads land under var/, not under data/. data/ is mounted read-only, which is
# the point of it, so the local default of data/uploads cannot work here.
DBSSPEECH_UPLOADS=/app/var/uploads
